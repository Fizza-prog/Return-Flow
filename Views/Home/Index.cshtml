@{
    ViewData["Title"] = "Smart Returns & Quality Intelligence";
}

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">Return<span class="brand-accent">Flow</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                <li class="nav-item"><a class="nav-link active" href="#home">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                <li class="nav-item"><a class="btn btn-primary px-4" asp-controller="Account" asp-action="Register">Get started</a></li>
            </ul>
        </div>
    </div>
</nav>

<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75 py-5">
            <div class="col-lg-7">
                <span class="badge mb-4">E-commerce returns, reimagined</span>
                <h1 class="mb-4">Returns are more than reversals. They're insights.</h1>
                <p class="lead mb-4">ReturnFlow brings return management, product inspections, and quality intelligence together in one streamlined platform for modern ecommerce businesses.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Get started</a>
                    <a href="#features" class="btn btn-outline-light btn-lg">Explore features</a>
                </div>
                <div class="hero-stats mt-5 d-flex flex-wrap gap-4">
                    <div><h4>Manage returns</h4><small class="text-muted">Requests and approvals</small></div>
                    <div><h4>Inspect products</h4><small class="text-muted">Condition and disposition</small></div>
                    <div><h4>Understand quality</h4><small class="text-muted">Patterns behind returns</small></div>
                </div>
            </div>
            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="hero-visual p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div><small class="text-muted">ReturnFlow overview</small><h5 class="mt-1 mb-0">Returns snapshot</h5></div>
                        <span class="badge">Demo</span>
                    </div>
                    <div class="dashboard-preview-card mb-3">
                        <small class="text-muted">Total return requests</small>
                        <div class="d-flex justify-content-between align-items-end mt-2">
                            <h2 class="mb-0">248</h2><span class="preview-tag">+12 this week</span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><div class="dashboard-preview-card h-100"><small class="text-muted">Pending</small><h3 class="mt-2 mb-0">36</h3></div></div>
                        <div class="col-6"><div class="dashboard-preview-card h-100"><small class="text-muted">Approved</small><h3 class="mt-2 mb-0">172</h3></div></div>
                    </div>
                    <div class="dashboard-preview-card">
                        <div class="d-flex justify-content-between mb-3"><small class="text-muted">Return processing</small><small>78%</small></div>
                        <div class="progress" role="progressbar" aria-label="Return processing progress" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: 78%;"></div>
                        </div>
                        <small class="text-muted d-block mt-2">Sample dashboard data for demonstration</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="about" class="py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="section-label">About ReturnFlow</span>
                <h2 class="display-6 mt-2">A smarter approach to product returns.</h2>
            </div>
            <div class="col-lg-7">
                <p class="lead">Managing product returns shouldn't mean losing valuable business information.</p>
                <p>ReturnFlow is designed to simplify the ecommerce return process while helping businesses understand why products are returned. From customer requests to manager inspections, the platform organizes each stage in one place.</p>
                <p class="mb-0">Its goal is not only to manage returned products, but also to turn return-related information into useful product quality insights.</p>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-5">
    <div class="container py-4">
        <div class="text-center mx-auto mb-5" style="max-width: 650px;">
            <span class="section-label">What the platform offers</span>
            <h2 class="display-6 mt-2 mb-3">One platform. Three essential workflows.</h2>
            <p class="text-muted">A connected workflow for customers, managers, and administrators to handle ecommerce returns more effectively.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon mb-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6" /></svg></div>
                    <h4 class="mb-3">Return management</h4><p>Customers can submit return requests and track their status, while managers review and process requests through a centralized workflow.</p><span class="tag">Customer workflow</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon mb-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></div>
                    <h4 class="mb-3">Product inspection</h4><p>Managers can record returned product conditions, document inspection findings, and determine the appropriate product disposition.</p><span class="tag">Quality control</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon mb-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg></div>
                    <h4 class="mb-3">Quality intelligence</h4><p>Return-related information can help administrators identify recurring product issues and understand patterns behind customer returns.</p><span class="tag">Business insights</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="cta-section p-5 text-center">
            <h2 class="display-6 mb-3">Make every return count.</h2>
            <p class="mx-auto mb-4" style="max-width: 600px;">Bring structure to your return process and make better decisions with organized product quality information.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Create your account</a>
        </div>
    </div>
</section>

<footer class="footer py-4">
    <div class="container">
        <div class="row align-items-center gy-3">
            <div class="col-md-6">
                <h5 class="mb-1">Return<span class="brand-accent">Flow</span></h5>
                <small class="text-muted">Smart Ecommerce Returns &amp; Product Quality Intelligence</small>
            </div>
            <div class="col-md-6 text-md-end"><small class="text-muted">© 2026 ReturnFlow. All rights reserved.</small></div>
        </div>
    </div>
</footer>
