@{
    ViewData["BodyClass"] = "auth-page";
    ViewData["Title"] = "Error";
}

<main class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="auth-card p-4 p-md-5 text-center">
                    <h2 class="mb-2">Something went wrong</h2>
                    <p class="text-muted">An unexpected error occurred while processing your request.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</main>
